		gmode 4,0,0,175
		}
		if(cnt==2&&bet==bet_b){
		gmode 4,0,0,175
		}
		}
		pos 1280/2-(200/2)-200+(200*cnt),720/2-100/2+100//選択肢描写
		celput 13,cnt
		if(cnt==1&&(bet>=5||bet>=coin1||bet>=coin2)){
		gmode 4,0,0,255
		pos 1280/2-(200/2)-200+(200*cnt),720/2-100/2+100//選択不可描写
		celput 14,0
		}
		if(cnt==2&&bet==bet_b){
		gmode 4,0,0,255
		pos 1280/2-(200/2)-200+(200*cnt),720/2-100/2+100//選択不可描写
		celput 14,0
		}
