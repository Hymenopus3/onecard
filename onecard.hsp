*drawcoin//コイン描写
	gmode 4,0,0,255
	if(coin1>0){
	if(coin1<=10){
	repeat coin1
		pos 0+5+(cnt*50),720-100+7//プレイヤーコイン描写
		celput 203,0
	loop
	}else{
	repeat coin1/10
		pos 0+5+(cnt*50),720-100+7//プレイヤーコイン100描写
		celput 204,0
	loop
	repeat coin1\10
		pos 0+5+(cnt*50)+((coin1/10)*50),720-100+7//プレイヤーコイン描写
		celput 203,0
	loop
	}
}
	gmode 4,0,0,255
	if(coin2>0){
	if(coin2<=10){
	repeat coin2
		pos 0+5+(cnt*50)+640,720-100+7//相手コイン描写
		celput 203,0
	loop
	}else{
	repeat coin2/10
		pos 0+5+(cnt*50)+640,720-100+7//相手コイン100描写
		celput 204,0
	loop
	repeat coin2\10
		pos 0+5+(cnt*50)+((coin2/10)*50)+640,720-100+7//相手コイン描写
		celput 203,0
	loop
	}
}
return

