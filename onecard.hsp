*setsound//音量調整
	if(key_1_c==1){//1が押されてたら音量減らす
		if(vol_s<4){
			vol_s+=1
			}
		vol_c=60
		mmvol 11,0-(vol_s*250)
		mmplay 11
	}	

	if(key_2_c==1){//2が押されてたら音量増やす
		if(vol_s>0){
			vol_s-=1
			}
		vol_c=60
		mmvol 11,0-(vol_s*250)
		mmplay 11
	}	

	if(key_3_c==1){//3が押されてたらBGM音量減らす
		if(vol_b<4){
			vol_b+=1
			}
		vol_cb=60
		mmvol 1,0-(vol_b*250)
	}	

	if(key_4_c==1){//4が押されてたらBGM音量増やす
		if(vol_b>0){
			vol_b-=1
			}
		vol_cb=60
		mmvol 1,0-(vol_b*250)
	}	
return

