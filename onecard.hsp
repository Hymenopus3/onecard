*checkkey//キーチェック
	//最小化してないか(ブラウザ版はここの確認をしない)
	IsIconic hwnd
	if (stat=0){//してないなら
	//ESCキー関連
	getkey key_esc,27
	if(key_esc==1){
		if(key_esc_c==0){
			key_esc_c=1
		}
		else{
		if(key_esc_c==1){
			key_esc_c=2
		}
	}
	}
	if(key_esc==0){
			key_esc_c=0
		}
		
	//z
	getkey key_z,90
	if(key_z==1){
		if(key_z_c==0){
			key_z_c=1
		}
